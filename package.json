{
  "name": "nexus-switcher",
  "version": "1.0.5",
  "description": "Nexus Switcher - Steam Account & Game Manager",
  "main": "main.js",
  "author": "DarkG",
  "repository": {
    "type": "git",
    "url": "https://github.com/kd9s/nexus-switcher"
  },
  "scripts": {
    "start": "electron .",
    "build": "node scripts/build.js",
    "postinstall": "node scripts/setup-assets.js"
  },
  "dependencies": {
    "vdf-parser": "^1.0.2"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.4.0",
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.darkg.nexusswitcher",
    "productName": "Nexus Switcher",
    "copyright": "Copyright (c) 2025 DarkG",
    "win": {
      "target": "nsis",
      "icon": "icon.png",
      "requestedExecutionLevel": "asInvoker",
      "forceCodeSigning": false
    },
    "forceCodeSigning": false,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nexus Switcher",
      "allowElevation": true,
      "perMachine": false,
      "runAfterFinish": true
    },
    "files": [
      "**/*",
      "!node_modules/.cache",
      "!node_modules/@fortawesome/**",
      "!dist",
      "!.git"
    ]
  }
}
